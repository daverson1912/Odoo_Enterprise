<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="print_batch_payment">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page page_batch_payment" style="font-size: 13px;">
                    <div class="oe_structure"></div>
                    
                    <!-- Nombre del Formato -->
                    <h3 class="mt-3 mb-4 text-center">
                        <strong>
                            <t t-if="o.batch_type == 'outbound'">PAGO POR LOTES DE PROVEEDORES</t>
                            <t t-else="">PAGO POR LOTES DE CLIENTES</t>
                        </strong>
                    </h3>

                    <!-- Detalles del Lote y RIF -->
                    <div class="row mb-4 mt-3" style="border-bottom: 1px solid #ddd; padding-bottom: 15px;">
                        <!-- Columna Izquierda -->
                        <div class="col-6 text-start">
                            <strong>RIF de la Empresa:</strong> <span t-field="o.company_id.vat"/><br/>
                            <strong>Referencia de Lote:</strong> <span t-field="o.name"/><br/>
                            <strong>Banco/Diario:</strong> <span t-field="o.journal_id.name"/><br/>
                        </div>
                        <!-- Columna Derecha -->
                        <div class="col-6 text-end">
                            <t t-if="o.journal_id.bank_acc_number">
                                <strong>Cuenta Bancaria Emisora:</strong> <span t-field="o.journal_id.bank_acc_number"/><br/>
                            </t>
                            <strong>Fecha de Emisión:</strong> <span t-field="o.date" t-options='{"widget": "date"}'/><br/>
                            <strong>Método de Pago:</strong> <span t-field="o.payment_method_id.name"/><br/>
                        </div>
                    </div>

                    <div class="oe_structure"></div>
                    
                    <!-- Tabla de Pagos -->
                    <table class="table table-sm table-bordered mt-3">
                        <thead>
                            <tr style="background-color: #f8f9fa;">
                                <th t-if="o.batch_type == 'outbound'" class="text-start">Proveedor</th>
                                <th t-if="o.batch_type == 'inbound'" class="text-start">Cliente</th>
                                <th t-if="o.batch_type == 'outbound'" class="text-start">Titular de la Cuenta</th>
                                <th class="text-start">Fecha</th>
                                <th class="text-start">Nro de Factura</th>
                                <th class="text-start">Cuenta Destino</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.payment_ids" t-as="payment">
                                <td class="text-start"><span t-out="payment.partner_id.name">ABC Suppliers</span></td>
                                <td t-if="o.batch_type == 'outbound'" class="text-start"><span t-out="payment.partner_bank_id.acc_holder_name"> ABC Holder Name</span></td>
                                <td class="text-start"><span t-out="payment.date" t-options='{"widget": "date"}'>2023-08-15</span></td>
                                <td class="text-start"><span t-out="payment.memo">Demo Ref</span></td>
                                <td class="text-start"><span t-out="payment.partner_bank_id.acc_number">3956012345678</span></td>
                                <td class="text-end"><span t-out="payment.amount" t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}">$1000.0</span></td>
                            </tr>
                            <tr style="font-weight: bold; background-color: #f8f9fa;">
                                <td>TOTAL</td>
                                <td t-if="o.batch_type == 'outbound'"></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-end"><span t-out="abs(o.amount)" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}">$1000.0</span></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="oe_structure"></div>
                </div>

                <!-- Pie de página personalizado con Firmas y Paginación -->
                <div class="footer" style="font-size: 13px;">
                    <div class="row text-center mb-4">
                        <div class="col-6">
                            <div style="border-top: 1px solid black; width: 60%; margin: 0 auto;"/>
                            <strong>ELABORADO POR</strong>
                        </div>
                        <div class="col-6">
                            <div style="border-top: 1px solid black; width: 60%; margin: 0 auto;"/>
                            <strong>RECIBIDO POR</strong>
                        </div>
                    </div>
                    <div class="d-flex border-top pt-2">
                        <div class="flex-grow-1 text-start me-2" t-field="o.company_id.report_footer"/>
                        <div class="text-end text-muted text-nowrap">
                            Página <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
