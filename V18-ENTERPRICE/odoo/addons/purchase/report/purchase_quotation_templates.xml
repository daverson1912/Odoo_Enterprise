<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_purchasequotation_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="address"/>
        <t t-if="o.dest_address_id">
            <t t-set="information_block">
                <strong class="d-block mt-3">Shipping address:</strong>
                <div t-field="o.dest_address_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
            </t>
        </t>
        <div class="page">
            <div class="oe_structure"/>
            <t t-set="layout_document_title">
                <!-- Título Traducido -->
                <h2 class="mt-3 mb-4">
                    <span>Solicitud de cotización </span>
                    <span t-field="o.name"/>
                </h2>

                <!-- Cuadro Superior con Dirección de Envío -->
                <div class="row mb-4 mt-3" style="font-size: 13px;">
                    <!-- Columna Izquierda: Empresa y Datos de Envío -->
                    <div class="col-6">
                        <strong>RIF de la Empresa:</strong> <span t-field="o.company_id.vat"/><br/>
                        <strong>Nombre de la Tienda:</strong> 
                        <t t-if="o.dest_address_id">
                            <span t-field="o.dest_address_id.name"/>
                        </t>
                        <t t-else="">
                            <span t-field="o.company_id.name"/>
                        </t>
                        <br/>
                        <strong>Fecha de Emisión:</strong> <span t-field="o.date_order" t-options='{"widget": "date"}'/><br/>
                        
                        <!-- Dirección de envío y teléfono -->
                        <div class="mt-2">
                            <strong>Dirección de Envío:</strong><br/>
                            <t t-if="o.dest_address_id">
                                <span t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                            </t>
                            <t t-else="">
                                <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                            </t>
                        </div>
                    </div>
                    
                    <!-- Columna Derecha: Proveedor -->
                    <div class="col-6 text-end">
                        <strong>Proveedor:</strong> <span t-field="o.partner_id.name"/><br/>
                        <strong>RIF Proveedor:</strong> <span t-field="o.partner_id.vat"/><br/>
                        <strong>Teléfono:</strong> <span t-field="o.partner_id.phone"/><br/>
                        <strong>Dirección:</strong> <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    </div>
                </div>
            </t>

            <table class="table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_code" class="text-start"><strong>Código</strong></th>
                        <th name="th_description" class="text-start"><strong>Descripción</strong></th>
                        <th name="th_expected_date" class="text-center"><strong>Fecha Prevista</strong></th>
                        <th name="th_quantity" class="text-end"><strong>Cantidad</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.order_line" t-as="order_line">
                        <tr t-att-class="'fw-bold o_line_section' if order_line.display_type == 'line_section' else 'fst-italic o_line_note' if order_line.display_type == 'line_note' else ''">
                            <t t-if="not order_line.display_type">
                                <td>
                                    <span t-field="order_line.product_id.default_code"/>
                                </td>
                                <td id="product">
                                    <span t-field="order_line.product_id.name"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="order_line.date_planned"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="order_line.product_qty"/>
                                    <span t-field="order_line.product_uom" groups="uom.group_uom"/>
                                    <span t-if="order_line.product_packaging_id">
                                        (<span t-field="order_line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="order_line.product_packaging_id"/>)
                                    </span>
                                </td>
                            </t>
                            <t t-else="">
                                <td colspan="99" id="section">
                                    <span t-field="order_line.name"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>


            <div class="oe_structure"/>

            <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
            <t t-set="portal_url" t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
            <div t-if="any(u._is_portal() for u in o.partner_id.user_ids)" class="text-center">
                <a t-att-href="portal_url">Connect your software</a> with <t t-out="o.company_id.name"/> to create quotes automatically.
            </div>
        </div>
    </t>
</template>

<template id="report_purchasequotation">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="purchase.report_purchasequotation_document" t-lang="o.partner_id.lang"/>
        </t>
    </t>
</template>
</odoo>
