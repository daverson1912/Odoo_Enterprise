<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_saleorder_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="address"/>
        <t t-set="information_block"/>
        <div class="page">
            <div class="oe_structure"/>
            <!-- CONTENEDOR PARA SATISFACER XPATHS DE MÓDULOS HEREDADOS (Evita que falle la actualización de Odoo) -->
            <div style="display: none !important;">
                <div id="informations">
                    <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                        <div t-field="doc.client_order_ref"/>
                    </div>
                    <div t-if="doc.date_order" class="col" name="informations_date">
                        <div t-field="doc.date_order"/>
                    </div>
                    <div t-if="doc.validity_date" class="col" name="expiration_date">
                        <div t-field="doc.validity_date"/>
                    </div>
                    <div t-if="doc.user_id.name" class="col">
                        <div t-field="doc.user_id"/>
                    </div>
                </div>
            </div>

            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <t t-set="layout_document_title">
                <!-- Título Traducido -->
                <h2 class="mt-3 mb-4">
                    <t t-if="is_proforma"><span>Factura Pro-Forma # </span></t>
                    <t t-elif="doc.state in ['draft','sent']"><span>Presupuesto # </span></t>
                    <t t-else=""><span>Orden de venta # </span></t>
                    <span t-field="doc.name"/>
                </h2>

                <!-- Cuadro Superior con Dirección y Datos de la Venta -->
                <div class="row mb-4 mt-3" style="font-size: 13px;">
                    <!-- Columna Izquierda: Nuestra Empresa -->
                    <div class="col-6">
                        <strong>RIF de la Empresa:</strong> <span t-field="doc.company_id.vat"/><br/>
                        <strong>Nombre de la Empresa:</strong> <span t-field="doc.company_id.name"/><br/>
                        <strong>Fecha de Emisión:</strong>
                        <span t-field="doc.date_order" t-options='{"widget": "date"}'/><br/>
                        <t t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                            <strong>Vencimiento:</strong> <span t-field="doc.validity_date" t-options='{"widget": "date"}'/><br/>
                        </t>
                        <t t-if="doc.user_id">
                            <strong>Vendedor:</strong> <span t-field="doc.user_id.name"/><br/>
                        </t>
                    </div>
                    
                    <!-- Columna Derecha: Datos del Cliente -->
                    <div class="col-6 text-end">
                        <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/><br/>
                        <strong>RIF / CI:</strong> <span t-field="doc.partner_id.vat"/><br/>
                        <t t-if="doc.partner_id.phone">
                            <strong>Teléfono:</strong> <span t-field="doc.partner_id.phone"/><br/>
                        </t>
                        
                        <!-- Direcciones de Facturación y Envío -->
                        <div class="mt-2 text-end">
                            <strong>Dirección de Facturación:</strong><br/>
                            <span t-field="doc.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            
                            <t t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_invoice_id">
                                <div class="mt-2">
                                    <strong>Dirección de Envío:</strong><br/>
                                    <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

            <div class="oe_structure"></div>
            <table class="o_has_total_table table o_main_table table-borderless">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_code" class="text-start"><strong>Código</strong></th>
                        <th name="th_description" class="text-start"><strong>Descripción</strong></th>
                        <th name="th_quantity" class="text-end"><strong>Cantidad</strong></th>
                        <th name="th_priceunit" class="text-end"><strong>Precio Unitario</strong></th>
                        <th name="th_discount" t-if="display_discount" class="text-end">
                            <strong>Desc.</strong>
                        </th>
                        <th name="th_taxes" class="text-end"><strong>Impuestos</strong></th>
                        <th name="th_subtotal" class="text-end">
                            <strong>Importe</strong>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="lines_to_report" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <tr
                            t-att-class="'fw-bold o_line_section' if (
                                line.display_type == 'line_section'
                                or line.product_type == 'combo'
                            )
                            else 'fst-italic o_line_note' if line.display_type == 'line_note'
                            else ''"
                        >
                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                <td>
                                    <span t-field="line.product_id.default_code"/>
                                </td>
                                <td name="td_name">
                                    <span t-field="line.product_id.name">Bacon Burger</span>
                                    <p t-if="line.name and line.name != line.product_id.name and line.name != line.product_id.display_name">
                                        <span t-field="line.name"/>
                                    </p>
                                </td>
                                <td name="td_quantity" class="o_td_quantity text-end">
                                    <span t-field="line.product_uom_qty" class="text-nowrap">3</span>
                                    <span t-field="line.product_uom">units</span>
                                    <span t-if="line.product_packaging_id">
                                        (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                    </span>
                                </td>
                                <td name="td_priceunit" class="text-end text-nowrap">
                                    <span t-field="line.price_unit">3</span>
                                </td>
                                <td t-if="display_discount" class="text-end">
                                    <span t-field="line.discount"/>%
                                </td>
                                <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                    <span t-out="taxes">Tax 15%</span>
                                </td>
                                <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_subtotal">27.00</span>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </t>
                        </tr>

                        <t
                            t-if="current_section and (
                                line_last
                                or lines_to_report[line_index+1].display_type == 'line_section'
                                or lines_to_report[line_index+1].product_type == 'combo'
                                or (
                                    line.combo_item_id
                                    and not lines_to_report[line_index+1].combo_item_id
                                )
                            ) and not line.is_downpayment"
                        >
                            <t t-set="current_section" t-value="None"/>
                            <tr class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-out="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                    >31.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
             <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-3" name="total">
                    <div t-attf-class="#{'col-5' if report_type != 'html' else 'col-sm-6 col-md-5'} ms-auto">
                        <table class="o_total_table table table-sm table-borderless" style="font-size: 13px; margin-top: 10px; margin-bottom: 0px;">
                            <!-- Calcular Exento y Base Imponible -->
                            <t t-set="exempt_amount" t-value="0.0"/>
                            <t t-set="taxable_amount" t-value="0.0"/>
                            <t t-foreach="lines_to_report" t-as="line">
                                <t t-if="not line.display_type and line.product_type != 'combo'">
                                    <t t-set="has_tax" t-value="any(t.amount != 0 for t in line.tax_id)"/>
                                    <t t-if="not line.tax_id or not has_tax">
                                        <t t-set="exempt_amount" t-value="exempt_amount + line.price_subtotal"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="taxable_amount" t-value="taxable_amount + line.price_subtotal"/>
                                    </t>
                                </t>
                            </t>
                            
                            <tr style="color: #666; border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;">
                                <td>Exento</td>
                                <td class="text-end">
                                    <span t-out="exempt_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr style="color: #666; border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;">
                                <td>Base Imponible</td>
                                <td class="text-end">
                                    <span t-out="taxable_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr style="color: #666; border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;">
                                <td>Impuestos</td>
                                <td class="text-end">
                                    <span t-out="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr style="font-size: 15px; color: #212529; border-bottom: 1px solid rgba(0, 0, 0, 0.15) !important;">
                                <td><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong t-out="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="oe_structure"></div>

            <!-- Firma Digital (si está firmada en el portal) -->
            <div t-if="doc.signature" class="mt-4 text-center" name="signature" style="page-break-inside: avoid;">
                <div class="offset-8">
                    <strong>Firma Digital Cliente</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 3cm; max-width: 6cm;"/>
                </div>
                <div class="offset-8">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>

            <!-- Notas y Condiciones de Pago -->
            <div style="font-size: 13px; margin-top: 20px;">
                <!-- Nota principal del documento -->
                <div t-if="doc.note" class="mb-2">
                    <strong>Notas:</strong>
                    <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                </div>
                
                <!-- Plazos de pago o nota de plazos de pago -->
                <div t-if="doc.payment_term_id" class="mb-2">
                    <strong>Condiciones de Pago:</strong>
                    <span t-field="doc.payment_term_id"/>
                    <span t-if="not is_html_empty(doc.payment_term_id.note)" t-field="doc.payment_term_id.note" class="d-block mt-1 text-muted"/>
                </div>

                <!-- Nota de Posición Fiscal -->
                <div t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                    <strong>Nota de Posición Fiscal:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note"/>
                </div>
            </div>
            <div class="oe_structure"/>
        </div>

        <!-- Pie de página personalizado con Firmas y Paginación -->
        <div class="footer" style="font-size: 13px;">
            <div class="row text-center mb-4">
                <div class="col-6">
                    <div style="border-top: 1px solid black; width: 60%; margin: 0 auto;"/>
                    <strong>ELABORADO POR</strong>
                </div>
                <div class="col-6">
                    <div style="border-top: 1px solid black; width: 60%; margin: 0 auto;"/>
                    <strong>RECIBIDO POR</strong>
                </div>
            </div>
            <div class="d-flex border-top pt-2">
                <div class="flex-grow-1 text-start me-2" t-field="doc.company_id.report_footer"/>
                <div class="text-end text-muted text-nowrap">
                    Página <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </t>
</template>

<template id="report_saleorder_raw">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

<template id="report_saleorder">
    <t t-call="sale.report_saleorder_raw"/>
</template>

<template id="report_saleorder_pro_forma">
    <t t-call="web.html_container">
        <t t-set="is_pro_forma" t-value="True"/>
        <t t-set="docs" t-value="docs.with_context(proforma=True)"/>
        <t t-foreach="docs" t-as="doc">
            <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

 <!-- Allow edits (e.g. studio) without changing the often inherited base template -->
<template id="document_tax_totals" inherit_id="account.document_tax_totals_template" primary="True"></template>

<template id="quote_document_layout_preview">
    <t t-call="web.html_preview_container">
        <t t-call="sale.report_saleorder_document"/>
    </t>
</template>

</odoo>
